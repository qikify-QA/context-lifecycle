{
  "$comment": "input/ccr-fastpath-plan.json (contracts/ccr-protocol.md §12.3a).",
  "type": "object",
  "required": [
    "proposal_id",
    "claims"
  ],
  "properties": {
    "proposal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_key",
          "strength"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLAIM-\\d{2,}$"
          },
          "claim_key": {
            "type": "string"
          },
          "strength": {
            "enum": [
              "S3",
              "S1",
              "S0"
            ]
          },
          "confirmation_source": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "type",
              "ref"
            ],
            "properties": {
              "type": {
                "enum": [
                  "spec_doc",
                  "dev_doc",
                  "po_dev_confirm",
                  "test_case"
                ]
              },
              "ref": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "anyOf": [
                      {
                        "required": [
                          "citation"
                        ]
                      },
                      {
                        "required": [
                          "locator"
                        ]
                      }
                    ]
                  }
                ],
                "anyOfMessage": "ref phải là chuỗi citation, hoặc object có citation/locator (§3)"
              },
              "derivation": {
                "enum": [
                  "prose",
                  "code_artifact"
                ]
              }
            }
          },
          "shipped": {
            "enum": [
              "SHIPPED",
              "NOT_SHIPPED",
              "UNKNOWN"
            ]
          },
          "relation": {
            "enum": [
              "ADD",
              "SUPERSEDES",
              "CONTRADICTS",
              "UNKNOWN"
            ]
          },
          "target_kb_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
