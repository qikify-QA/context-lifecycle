{
  "$comment": "run-manifest.json (contract §5, §15). Không phải artifact envelope.",
  "type": "object",
  "required": [
    "product",
    "mode",
    "status"
  ],
  "anyOf": [
    {
      "required": [
        "run_id"
      ]
    },
    {
      "required": [
        "ctx_run_id"
      ]
    }
  ],
  "anyOfMessage": "thiếu run_id",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^CTX-\\d{8}-\\d{2,}$"
    },
    "ctx_run_id": {
      "type": "string",
      "pattern": "^CTX-\\d{8}-\\d{2,}$"
    },
    "product": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "ZERO_DOC_BOOTSTRAP",
        "BROAD_BOOTSTRAP",
        "DOC_BOOTSTRAP",
        "INCREMENTAL_UPDATE",
        "CCR_INGEST",
        "REFRESH",
        "RECONCILE",
        "KNOWLEDGE_RESTRUCTURE"
      ]
    },
    "mode_settled_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "IN_PROGRESS",
        "REWORK_REQUIRED",
        "PUBLISHED",
        "BLOCKED",
        "REJECTED",
        "CONFLICT",
        "DEFERRED"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(CBS|CCR|QA)-"
        }
      }
    },
    "produced_open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OQ-[a-z0-9-]+-\\d{3,}$"
      }
    }
  }
}
