{
  "$comment": "candidate/checklists/*.json — payload của RegressionChecklistCandidate.",
  "type": "object",
  "required": [
    "checklists"
  ],
  "properties": {
    "checklists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "feature_key",
          "checks"
        ],
        "properties": {
          "feature_key": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "check_id",
                "oracle",
                "status"
              ],
              "properties": {
                "check_id": {
                  "type": "string",
                  "pattern": "^CHK-"
                },
                "status": {
                  "enum": [
                    "READY",
                    "NEEDS_CONFIRMATION"
                  ]
                },
                "priority": {
                  "enum": [
                    "P1",
                    "P2",
                    "P3"
                  ]
                },
                "oracle": {
                  "type": "object",
                  "required": [
                    "oracle_strength"
                  ],
                  "properties": {
                    "oracle_strength": {
                      "enum": [
                        "STRONG",
                        "BASELINE",
                        "NONE"
                      ]
                    },
                    "kb_ids": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
