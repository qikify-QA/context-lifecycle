{
  "$comment": "Artifact Envelope (contract §1) — kiểm cho mọi artifact của subagent. Field nghiệp vụ nằm ở payload (hoặc top-level với artifact cũ).",
  "type": "object",
  "required": [
    "artifact_type",
    "producer",
    "status"
  ],
  "properties": {
    "artifact_type": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "status": {
      "enum": [
        "READY",
        "PARTIAL",
        "BLOCKED",
        "REJECTED"
      ]
    },
    "gate": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "PASS",
            "CONDITIONAL_PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        }
      }
    }
  }
}
