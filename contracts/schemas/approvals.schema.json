{
  "$comment": "input/approvals.json — quyết định của người có vai trò trong config owners cho diff entry requires_human_decision (contracts/supersede.md). Orchestrator ghi; không ghi tên/email người.",
  "type": "object",
  "required": ["approvals"],
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kb_id", "decision", "approver_role", "ref", "decided_at"],
        "properties": {
          "change_id": { "type": ["string", "null"] },
          "kb_id": { "type": "string", "pattern": "^KB-" },
          "decision": { "enum": ["ACCEPT_CANDIDATE", "KEEP_BASE", "KEEP_BOTH"] },
          "approver_role": { "type": "string" },
          "ref": { "type": "string" },
          "decided_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
        }
      }
    }
  }
}
