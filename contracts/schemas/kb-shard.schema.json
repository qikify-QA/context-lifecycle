{
  "$comment": "candidate/product-kb/*.json — payload của ProductKBCandidate (qa-knowledge-normalizer).",
  "type": "object",
  "required": [
    "kb_candidates"
  ],
  "properties": {
    "kb_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kb_id",
          "statement",
          "knowledge_kind",
          "confidence",
          "scope"
        ],
        "properties": {
          "kb_id": {
            "type": "string",
            "pattern": "^KB-"
          },
          "statement": {
            "type": "string"
          },
          "knowledge_kind": {
            "enum": [
              "CONFIRMED_EXPECTED",
              "OBSERVED_CURRENT",
              "INFERRED",
              "PROPOSED"
            ]
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "scope": {
            "type": "object",
            "required": [
              "environment"
            ],
            "properties": {
              "environment": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "UNRESOLVED",
              "KNOWN_DEFECT",
              "CONFLICTED"
            ]
          },
          "confirmation_source": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "type",
              "ref"
            ],
            "properties": {
              "type": {
                "enum": [
                  "spec_doc",
                  "dev_doc",
                  "po_dev_confirm",
                  "test_case"
                ]
              },
              "ref": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "anyOf": [
                      {
                        "required": [
                          "citation"
                        ]
                      },
                      {
                        "required": [
                          "locator"
                        ]
                      }
                    ]
                  }
                ],
                "anyOfMessage": "ref phải là chuỗi citation, hoặc object có citation/locator (§3)"
              },
              "derivation": {
                "enum": [
                  "prose",
                  "code_artifact"
                ]
              }
            }
          }
        }
      }
    }
  }
}
