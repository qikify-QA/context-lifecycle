{
  "$comment": "review/verdict.json — payload của ContextReviewVerdict (contracts/gates.md).",
  "type": "object",
  "required": [
    "decision",
    "gate_results",
    "publish_allowed"
  ],
  "properties": {
    "decision": {
      "enum": [
        "APPROVED",
        "APPROVED_WITH_CONDITIONS",
        "REJECTED"
      ]
    },
    "publish_allowed": {
      "type": "boolean"
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "CONDITIONAL_PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    }
  }
}
