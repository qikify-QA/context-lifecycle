{
  "$comment": "review/knowledge-diff.json — payload của KnowledgeDiffArtifact (contracts/supersede.md).",
  "type": "object",
  "required": [
    "change_details"
  ],
  "properties": {
    "change_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "added",
              "changed",
              "refreshed_only",
              "deprecated",
              "conflicted"
            ]
          },
          "resolution": {
            "enum": [
              "ADDED",
              "REFRESHED_ONLY",
              "SUPERSEDE",
              "CONFLICTED",
              "PROPOSED"
            ]
          },
          "impact": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "supersede_blockers": {
            "type": "array"
          }
        }
      }
    }
  }
}
