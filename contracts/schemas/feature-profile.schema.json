{
  "$comment": "candidate/feature-profiles/*.json — payload của FeatureProfileCandidate.",
  "type": "object",
  "required": [
    "feature_profiles"
  ],
  "properties": {
    "feature_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "feature_key",
          "name",
          "user_goal"
        ],
        "properties": {
          "feature_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "user_goal": {
            "type": "string"
          },
          "observed_validations": {
            "type": "array"
          },
          "unknown_areas": {
            "type": "array"
          },
          "environment_differences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "test_env",
                "production",
                "how_to_test",
                "kb_refs"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "ALTERNATIVE_SETUP",
                    "NOT_TESTABLE",
                    "DIFFERENT_VALUE"
                  ]
                },
                "test_env": {
                  "type": "string"
                },
                "production": {
                  "type": "string"
                },
                "how_to_test": {
                  "type": "string"
                },
                "kb_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
