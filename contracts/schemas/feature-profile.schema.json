{
  "$comment": "candidate/feature-profiles/*.json — payload của FeatureProfileCandidate.",
  "type": "object",
  "required": [
    "feature_profiles"
  ],
  "properties": {
    "feature_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "feature_key",
          "name",
          "user_goal"
        ],
        "properties": {
          "feature_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "user_goal": {
            "type": "string"
          },
          "observed_validations": {
            "type": "array"
          },
          "unknown_areas": {
            "type": "array"
          }
        }
      }
    }
  }
}
