{
  "$comment": "intermediate/doc/<DOC-ID>.json — payload của DocumentationEvidenceArtifact.",
  "type": "object",
  "required": [
    "doc_context",
    "sections",
    "claims"
  ],
  "properties": {
    "doc_context": {
      "type": "object",
      "required": [
        "doc_id"
      ],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^DOC-\\d{2,}$"
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "dsec_ids",
          "quote",
          "claim_kind",
          "normativity"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-\\d{2,}-\\d{3,}[a-z]?$"
          },
          "dsec_ids": {
            "type": "array",
            "minItems": 1
          },
          "quote": {
            "type": "string"
          },
          "claim_kind": {
            "enum": [
              "capability",
              "validation_rule",
              "enum_or_boundary",
              "permission",
              "state_transition",
              "api_contract",
              "data_model",
              "side_effect",
              "integration",
              "config_default",
              "changelog_change",
              "known_defect",
              "vocabulary",
              "non_normative"
            ]
          },
          "normativity": {
            "enum": [
              "EXPLICIT",
              "IMPLIED_BY_CODE_ARTIFACT",
              "EXAMPLE_ONLY",
              "HEDGED_RATIONALE"
            ]
          }
        }
      }
    }
  }
}
