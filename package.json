{
  "name": "teeinblue-context-builder",
  "version": "1.0.0",
  "private": true,
  "description": "QA context builder: sản xuất canonical QA context (Product KB, Feature Profile, Checklist) cho repo qa-knowledge",
  "scripts": {
    "ops-board": "node ops-board/server.mjs",
    "test": "node --test 'scripts/ctx/test/*.test.mjs'",
    "manifest": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check",
    "validate:run": "node scripts/ctx/validate-run.mjs",
    "publish:dry": "node scripts/publish-knowledge.mjs",
    "prune": "node scripts/prune-runs.mjs",
    "portal-auth": "npx playwright test --config tools/portal-auth/playwright.config.ts --project=setup",
    "appendix": "node scripts/sync-appendix.mjs",
    "products": "node scripts/ctx/products.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0"
  }
}
