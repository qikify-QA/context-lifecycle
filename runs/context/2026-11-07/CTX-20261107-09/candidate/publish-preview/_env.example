# Biến env của người test teeinblue. Chép thành .env rồi điền giá trị, không commit .env.
# File này chỉ có tên biến. Dùng biến nào cho việc gì: _product-guide.md mục 3.

# Host
TIB_STAGING_PORTAL=
# Repo context-lifecycle (explorer) đọc tên này, cùng giá trị với TIB_STAGING_PORTAL
TIB_PORTAL_BASE=
TIB_API_BASE=
TIB_OPENAPI_BASE=

# Account chính
TIB_STAGING_EMAIL=
TIB_STAGING_PASSWORD=

# Hai tenant: permission, cross-tenant
TIB_USER_A_EMAIL=
TIB_USER_A_PASSWORD=
TIB_USER_B_EMAIL=
TIB_USER_B_PASSWORD=

# Store mặc định: dev store non-Plus, SDK v1
TIB_STORE_URL=
TIB_STORE_PASSWORD=
TIB_STORE_INSTANCE_ID=

# Store Shopify Plus: Checkout page, SDK v2
TIB_SDK_V2=
TIB_SDK_V2_PASSWORD=
TIB_SDK_V2_INSTANCE_ID=

# Boundless / open platform
TIB_BOUNDLESS_EMAIL=
TIB_BOUNDLESS_PASSWORD=
TIB_BOUNDLESS_INSTANCE_ID=
TIB_BOUNDLESS_STOREFRONT_INSTANCE_ID=

# Account đặc thù
TIB_ONBOARDING_EMAIL=
TIB_ONBOARDING_PASSWORD=
TIB_STAFF_VIEW_ONLY=
TIB_STAFF_VIEW_ONLY_PASSWORD=
TIB_STAFF_GEN_ONLY=
TIB_STAFF_GEN_ONLY_PASSWORD=
TIB_STAGING_PUBLIC_USER=
TIB_STAGING_PUBLIC_INSTANCE_ID=

# Token Open API theo ability
TIB_API_TOKEN=
TIB_FULL_ACCESS_TOKEN=
TIB_ORDERS_READ_TOKEN=
TIB_ORDERS_READONLY_TOKEN=
TIB_ORDERS_WRITE_TOKEN=
TIB_CUSTOMIZATIONS_READ_TOKEN=
TIB_CAMPAIGNS_WRITE_TOKEN=
TIB_ASSETS_READ_TOKEN=
TIB_ASSETS_RW_TOKEN=
TIB_USER_B_ASSETS_RW_TOKEN=
TIB_USER_B_CAMPAIGNS_WRITE_TOKEN=
TIB_USER_B_ORDERS_WRITE_TOKEN=

# Token negative auth
TIB_FORBIDDEN_TOKEN=
TIB_INVALID_TOKEN=
TIB_REVOKED_TOKEN=
TIB_ASSETS_REVOKED_TOKEN=
TIB_NO_ASSETS_TOKEN=

# Điều kiện đặc biệt
TIB_NO_MAPBOX_KEY_TOKEN=
