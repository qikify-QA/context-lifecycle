   "req_body": {
    "operationName": "getData",
    "variables": {
     "limit": 20
    },
    "query": "query getData($limit: Int!) {\n  layer_images_connection(\n    first: $limit\n    where: {deleted_at: {_is_null: true}, _and: [{master: {_nilike: \"%.svg\"}}, {master: {_nilike: \"%.gpx\"}}]}\n    order_by: {id: desc}\n  ) {\n    edges {\n      cursor\n      node {\n        id\n        master\n        url\n        thumbnail\n        name\n        width\n        height\n        created_at\n        layer_image_category_id\n        __typename\n      }\n      __typename\n    }\n    pageInfo {\n      hasNextPage\n      hasPreviousPage\n      startCursor\n      endCursor\n      __typename\n    }\n    __typename\n  }\n}"
   },
   "status": 200,
