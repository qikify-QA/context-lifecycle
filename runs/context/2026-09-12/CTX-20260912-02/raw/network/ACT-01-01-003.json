      "body": "{\"operationName\":\"get\",\"variables\":{\"id\":2595},\"query\":\"query get($id: bigint!) {\\n  product_counter: campaign_products_aggregate(where: {campaign_id: {_eq: $id}}) {\\n    aggregate {\\n      count\\n      __typename\\n    }\\n    __typename\\n  }\\n  campaign_products: campaign_products(\\n    where: {campaign_id: {_eq: $id}}\\n    order_by: {position: asc}\\n  ) {\\n    product {\\n      id\\n      title\\n      color_custom_label\\n      size_custom_label\\n      enable_custom_printarea\\n      printareas {\\n        id\\n        name\\n        display_name\\n        width\\n        height\\n        __typename\\n      }\\n      __typename\\n    }\\n    campaign_variants_aggregate(where: {variant: {available: {_eq: true}}}) {\\n      aggregate {\\n        count\\n        __typename\\n      }\\n      __typename\\n    }\\n    campaign_mockups_aggregate {\\n      aggregate {\\n        count\\n        __typename\\n      }\\n      __typename\\n    }\\n    campaign_image_mockups_aggregate: campaign_mockups_aggregate(\\n      where: {type: {_eq: \\\"image\\\"}}\\n    ) {\\n      aggregate {\\n        count\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n  campaign_artworks: campaign_artwork_printareas(\\n    where: {campaign_id: {_eq: $id}, deleted_at: {_is_null: true}}\\n  ) {\\n    artwork_id\\n    printarea_id\\n    __typename\\n  }\\n  variant_counter: campaign_variants_aggregate(\\n    where: {campaign_product: {campaign_id: {_eq: $id}}}\\n  ) {\\n    aggregate {\\n      count\\n      __typename\\n    }\\n    __typename\\n  }\\n  campaign_variants: campaign_variants(\\n    where: {campaign_product: {campaign_id: {_eq: $id}}}\\n  ) {\\n    variant_id\\n    variant {\\n      product_id\\n      color\\n      size\\n      price\\n      fulfillment_linked_id\\n      printarea_id\\n      variant_printareas {\\n        printarea_id\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\"}",
