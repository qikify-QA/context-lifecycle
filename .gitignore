
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# Playwright MCP session cache
.playwright-mcp/

# Concurrency lock files (ephemeral coordination state, not evidence — see contracts/qa-context-contract.md §16)
runs/.locks/

# Knowledge base: only keep _open-issues, products and the published manifest.
# manifest.json is what consumers read first — it must be tracked and published.
knowledge/*
!knowledge/_open-issues/
!knowledge/products/
!knowledge/manifest.json

# Tài liệu dev gửi sang (mode DOC_BOOTSTRAP) — CHƯA redact, không track.
# Bản đã redact nằm trong runs/context/**/input/docs/<DOC-ID>/ (contract §6, §9).
docs-input/*
!docs-input/README.md
