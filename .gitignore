
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# Playwright MCP / CLI session cache
.playwright-mcp/
.playwright-cli/

# Ghi chú legacy của operator (chứa định danh account) — giữ local, không track
runs/_archive/handover-legacy/

# Concurrency lock files (ephemeral coordination state, not evidence — see contracts/qa-context-contract.md §16)
runs/.locks/

# PR phát hành đang chờ merge (dữ liệu tạm giữa --pr và --tag của publish-knowledge)
runs/releases/

# knowledge/ là git submodule -> qikify-QA/qa-knowledge (repo riêng, có .gitignore riêng).

# Staging tạm của scripts/publish-knowledge.mjs
.publish-stage/

# Tài liệu dev gửi sang (mode DOC_BOOTSTRAP) — CHƯA redact, không track.
# Bản đã redact nằm trong runs/context/**/input/docs/<DOC-ID>/ (contract §6, §9).
# Lưu ý: doc lấy từ QA Hub không đi qua thư mục này; orchestrator ghi thẳng bản đã redact vào input/docs/.
docs-input/*
!docs-input/README.md

# ops-board: trạng thái live do PATCH /api/agents ghi — không track
ops-board/data/state.json

# Run evidence nặng (ảnh, network capture, doc) giữ local; chỉ track manifest + verdict (contract §15)
runs/context/*/*/*
!runs/context/*/*/run-manifest.json
!runs/context/*/*/review
runs/context/*/*/review/*
!runs/context/*/*/review/verdict.json
