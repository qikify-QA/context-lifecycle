         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>dear dad,</photoshop:LayerName>
                  <photoshop:LayerText>dear dad,</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>thanks for being my dad.</photoshop:LayerName>
                  <photoshop:LayerText>thanks for being my dad.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>if i had a different DAD</photoshop:LayerName>
                  <photoshop:LayerText>if i had a different DAD</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>i would punch him</photoshop:LayerName>
                  <photoshop:LayerText>i would punch him</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>in the face</photoshop:LayerName>
                  <photoshop:LayerText>in the face</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>and go find you.</photoshop:LayerName>
                  <photoshop:LayerText>and go find you.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>love,</photoshop:LayerName>
                  <photoshop:LayerText>love,</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>your favorite</photoshop:LayerName>
                  <photoshop:LayerText>your favorite</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
