{
  "schema_version": "1.0",
  "artifact_type": "ProductConfig",
  "product_key": "teeinblue",
  "label": "Teeinblue",
  "aliases": [
    "tib",
    "teeinblue"
  ],
  "status": "ACTIVE",
  "qa_hub": {
    "project_id": "proj-7082bc68-6228-4718-b22d-c8e6f95437ab",
    "project_key": "TIB",
    "mcp_server": "qa-hub-production",
    "project_id_note": "Xác minh 2026-09-30 bằng list_projects trên https://qa-hub.ownego.com. Giá trị cũ proj-5a26d73c-cbb2-4d19-b298-383bc4d16cf2 (từng hardcode trong contract §12.1 và orchestrator) KHÔNG tồn tại trên production — nhiều khả năng là id của instance local. Đừng khôi phục giá trị cũ mà không list_projects lại."
  },
  "modes": {
    "explore_enabled": true,
    "default_mode_bootstrap": "ZERO_DOC_BOOTSTRAP",
    "default_mode_update": "CCR_INGEST",
    "allowed_modes": [
      "ZERO_DOC_BOOTSTRAP",
      "BROAD_BOOTSTRAP",
      "INCREMENTAL_UPDATE",
      "REFRESH",
      "RECONCILE",
      "CCR_INGEST"
    ],
    "allowed_explorers": [
      "portal-explorer",
      "storefront-explorer",
      "api-explorer",
      "db-explorer",
      "code-config-explorer"
    ]
  },
  "doc_input": {
    "enabled": false,
    "dir": null,
    "default_doc_type": null,
    "allow_supersede_from_changelog": false
  },
  "environments": {
    "default": "staging",
    "allowed": [
      "staging"
    ],
    "forbidden": [
      "production"
    ],
    "staging": {
      "api_base_env": "TIB_API_BASE",
      "openapi_base_env": "TIB_OPENAPI_BASE",
      "portal_base_env": "TIB_PORTAL_BASE",
      "expected_api_base": "https://staging-api.teeinblue.com"
    }
  },
  "explore": {
    "playbook": "config/products/teeinblue/explore-playbook.md",
    "surfaces": {
      "portal": {
        "enabled": true,
        "base_env": "TIB_PORTAL_BASE",
        "login_path": "/login?staff=true",
        "auth": "staff_email_password",
        "session": "cookie",
        "session_ttl_minutes": 15
      },
      "storefront": {
        "enabled": true,
        "checkout_boundary": "cart",
        "buyer_states": [
          "guest"
        ]
      },
      "api": {
        "enabled": true,
        "base_env": "TIB_API_BASE",
        "spec_env": "TIB_OPENAPI_BASE"
      },
      "db": {
        "enabled": false,
        "note": "Chưa có read-only DB access cho staging."
      },
      "code": {
        "enabled": true,
        "note": "Chỉ dispatch kèm câu hỏi cụ thể và đường dẫn repo/revision do operator cấp."
      }
    },
    "account_guard": {
      "verify": "GET /api/user",
      "expected_user_id": 266,
      "note": "Chỉ thao tác trên account của TIB_STAGING_EMAIL. Sai id là stop condition. Chi tiết ở playbook."
    }
  },
  "credentials": {
    "env_prefix": "TIB_",
    "required_env": [
      "TIB_STAGING_EMAIL",
      "TIB_STAGING_PASSWORD",
      "TIB_API_BASE",
      "TIB_PORTAL_BASE"
    ],
    "secondary_account_env": [
      "TIB_USER_B_EMAIL",
      "TIB_USER_B_PASSWORD",
      "TIB_USER_B_STORE_URL"
    ],
    "negative_auth_env": [
      "TIB_FORBIDDEN_TOKEN",
      "TIB_INVALID_TOKEN"
    ]
  },
  "defaults": {
    "object_key_fallback": null,
    "role": "merchant-owner",
    "mutation_policy": "SAFE_REVERSIBLE_ONLY",
    "forbidden_actions": [
      "delete",
      "publish_live",
      "charge",
      "send_notification"
    ],
    "cleanup_required": true
  },
  "risk_tier": "HIGH",
  "supersede_policy": {
    "enabled": false,
    "allow_dev_doc_supersede": false,
    "never_supersede_topics": [
      "permission",
      "billing",
      "data-deletion",
      "fulfillment"
    ],
    "require_human_decision_impact": [
      "HIGH"
    ],
    "allow_reobserved_newer": false
  },
  "owners": {
    "_note": "Vai trò (không ghi tên/email — repo public) có quyền quyết khi diff cần requires_human_decision. objects ghi đè default cho từng object.",
    "default": [
      "PO"
    ],
    "objects": {}
  },
  "publish": {
    "consumer_label": "Teeinblue QA context",
    "stale_after_days": 45
  }
}
