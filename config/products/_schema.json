{
  "$comment": "Schema của config/products/<key>.json. scripts/lib/product-config.mjs validate mọi config ACTIVE theo file này (subset JSON Schema: type, required, enum, properties, items). Field ghi chú dạng *_note / *_README là tài liệu, không phải cấu hình.",
  "type": "object",
  "required": ["product_key", "label", "status", "qa_hub", "modes", "doc_input", "environments", "defaults", "supersede_policy", "publish"],
  "properties": {
    "product_key": { "type": "string" },
    "label": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["ACTIVE", "ONBOARDING", "INACTIVE"] },
    "qa_hub": {
      "type": "object",
      "required": ["project_id", "project_key", "mcp_server"],
      "properties": {
        "project_id": { "type": "string" },
        "project_key": { "type": "string" },
        "mcp_server": { "type": "string" }
      }
    },
    "modes": {
      "type": "object",
      "required": ["explore_enabled", "default_mode_bootstrap", "default_mode_update", "allowed_modes", "allowed_explorers"],
      "properties": {
        "explore_enabled": { "type": "boolean" },
        "default_mode_bootstrap": { "enum": ["ZERO_DOC_BOOTSTRAP", "BROAD_BOOTSTRAP", "DOC_BOOTSTRAP"] },
        "default_mode_update": { "enum": ["CCR_INGEST", "INCREMENTAL_UPDATE"] },
        "allowed_modes": {
          "type": "array",
          "items": { "enum": ["ZERO_DOC_BOOTSTRAP", "BROAD_BOOTSTRAP", "DOC_BOOTSTRAP", "INCREMENTAL_UPDATE", "CCR_INGEST", "REFRESH", "RECONCILE"] }
        },
        "allowed_explorers": {
          "type": "array",
          "items": { "enum": ["portal-explorer", "storefront-explorer", "api-explorer", "db-explorer", "code-config-explorer"] }
        }
      }
    },
    "doc_input": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" }, "allow_supersede_from_changelog": { "type": "boolean" } }
    },
    "environments": {
      "type": "object",
      "required": ["default", "allowed"],
      "properties": {
        "default": { "type": "string" },
        "allowed": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "explore": {
      "type": "object",
      "properties": {
        "playbook": { "type": ["string", "null"] },
        "surfaces": { "type": "object" },
        "account_guard": { "type": ["object", "null"] }
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "required_env": { "type": "array", "items": { "type": "string" } },
        "secondary_account_env": { "type": "array", "items": { "type": "string" } },
        "negative_auth_env": { "type": "array", "items": { "type": "string" } }
      }
    },
    "defaults": {
      "type": "object",
      "required": ["mutation_policy", "forbidden_actions"],
      "properties": {
        "object_key_fallback": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "mutation_policy": { "enum": ["SAFE_REVERSIBLE_ONLY", "NO_MUTATION"] },
        "forbidden_actions": { "type": "array", "items": { "type": "string" } },
        "cleanup_required": { "type": "boolean" }
      }
    },
    "supersede_policy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allow_dev_doc_supersede": { "type": "boolean" },
        "never_supersede_topics": { "type": "array", "items": { "type": "string" } },
        "allow_reobserved_newer": { "type": "boolean" }
      }
    },
    "publish": {
      "type": "object",
      "properties": { "consumer_label": { "type": "string" }, "stale_after_days": { "type": "number" } }
    }
  }
}
