{
  "schema_version": "1.0",
  "artifact_type": "ProductConfig",
  "product_key": "<<< ĐIỀN: slug, trùng tên file và tên thư mục knowledge/products/<key>/ >>>",
  "label": "<<< ĐIỀN: tên hiển thị >>>",
  "aliases": [],
  "status": "ACTIVE",

  "qa_hub": {
    "project_id": "<<< ĐIỀN: project_id của QAF trên QA Hub — lấy được sau khi QA_HUB_MCP_TOKEN hết 401 >>>",
    "project_key": "<<< ĐIỀN: key project trên QA Hub >>>",
    "mcp_server": "qa-hub"
  },

  "modes": {
    "explore_enabled": false,
    "default_mode_bootstrap": "DOC_BOOTSTRAP",
    "default_mode_update": "CCR_INGEST",
    "allowed_modes": ["DOC_BOOTSTRAP", "CCR_INGEST", "REFRESH"],
    "allowed_explorers": []
  },

  "doc_input": {
    "enabled": true,
    "dir": "<<< ĐIỀN: docs-input/<key>, hoặc null nếu không nhận doc >>>",
    "default_doc_type": "markdown_feature_doc",
    "allow_supersede_from_changelog": true
  },

  "environments": {
    "default": "documented",
    "allowed": ["documented"],
    "forbidden": ["production", "staging"],
    "documented": {
      "api_base_env": null,
      "openapi_base_env": null,
      "portal_base_env": null,
      "expected_api_base": null
    }
  },

  "credentials": {
    "env_prefix": null,
    "required_env": [],
    "secondary_account_env": [],
    "negative_auth_env": []
  },

  "defaults": {
    "object_key_fallback": null,
    "role": null,
    "mutation_policy": "NO_MUTATION",
    "forbidden_actions": ["*"],
    "cleanup_required": false
  },

  "risk_tier": "UNKNOWN",

  "supersede_policy": {
    "enabled": true,
    "allow_dev_doc_supersede": true,
    "never_supersede_topics": ["permission", "billing", "data-deletion", "payout", "commission-rate"],
    "require_human_decision_impact": ["HIGH"],
    "allow_reobserved_newer": false
  },

  "publish": {
    "consumer_label": "<<< ĐIỀN >>>",
    "stale_after_days": 90
  }
}
